{
  "name": "dsh-plugin-deepseek-balance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shows the DeepSeek total balance, the current peak/off-peak price period, and a countdown to the next price switch.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "homepage": "https://github.com/wzy816/dsh-plugin-deepseek-balance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzy816/dsh-plugin-deepseek-balance.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "balance",
    "pricing",
    "peak-hours"
  ]
}
